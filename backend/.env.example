NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# PostgreSQL Database
DATABASE_URL=postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Slack OAuth 2.0
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_CALLBACK_URL=http://localhost:5000/api/v1/slack/callback
SLACK_SCOPES=chat:write,channels:read,groups:read

# Ethereal SMTP (Leave blank to auto-generate ephemeral test account in dev)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Email Scheduling & Rate Limiting Controls
EMAIL_WORKER_CONCURRENCY=5
DEFAULT_EMAIL_DELAY_SECONDS=2
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Security Keys
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=reachinbox_super_secret_jwt_key_at_least_32_chars!

# Bull Board Queue Monitoring
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin_password
